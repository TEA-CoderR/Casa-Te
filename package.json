{
  "name": "casa-te-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:shared && npm run test:admin && npm run test:functions && npm run test:db",
    "test:shared": "tsx --test packages/shared/test/*.test.ts",
    "test:db": "bash tests/db/run.sh",
    "mobile": "npm run start -w @casa-te/mobile",
    "admin": "npm run dev -w @casa-te/admin",
    "test:functions": "tsx --test tests/functions/*.test.ts",
    "test:admin": "tsx --test apps/admin/test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "pg": "^8.13.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
