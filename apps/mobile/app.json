{
  "expo": {
    "name": "CASA & TE",
    "slug": "casa-te",
    "version": "1.2.5",
    "scheme": "casate",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "it.casate.app",
      "supportsTablet": true,
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "it.casate.app",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#3B6B31" }
    },
    "plugins": ["expo-router", "expo-web-browser", ["expo-image-picker", { "photosPermission": "Le foto servono per trovare un prodotto nel negozio online o per mostrare al negozio un prodotto danneggiato in una richiesta di reso.", "cameraPermission": "La fotocamera serve per fotografare un prodotto e trovarlo nel negozio online. La foto resta sul telefono.", "microphonePermission": false }], "./plugins/with-mlkit-ocr", ["expo-splash-screen", { "backgroundColor": "#3B6B31", "image": "./assets/brand/splash-mono.png", "imageWidth": 104 }]],
    "experiments": { "typedRoutes": true },
    "web": { "bundler": "metro", "output": "single", "favicon": "./assets/icon.png" },
    "extra": { "router": { "origin": false } }
  }
}
